rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isSignedIn() && (request.auth.token.email == 'luxproc.11@gmail.com');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Perfiles de usuario
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isMasterAdmin());
      allow list: if isMasterAdmin();
      allow create, update: if isSignedIn() && isOwner(userId);
      allow delete: if false;
    }

    // Diagnósticos individuales de usuarios
    match /diagnostics/{diagnosticId} {
      allow get, list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isMasterAdmin());
      allow create: if isSignedIn() && isValidId(diagnosticId);
      allow update, delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isMasterAdmin());
    }

    // Registro Maestro de Evaluaciones de Empresas (Acceso total para luxproc.11@gmail.com sin borrado)
    match /company_evaluations/{evaluationId} {
      allow get, list: if isMasterAdmin() || (isSignedIn() && resource.data.createdByEmail == request.auth.token.email);
      allow create: if isSignedIn() && isValidId(evaluationId);
      allow update: if isMasterAdmin();
      allow delete: if false; // Inmutable para preservar historial de todas las empresas
    }
  }
}
