rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profiles
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || resource.data.uid == request.auth.uid);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if isSignedIn() && isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.name is string;
      allow delete: if false;
    }

    // Diagnostics projects
    match /diagnostics/{diagnosticId} {
      allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(diagnosticId)
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(diagnosticId)
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(diagnosticId)
        && resource.data.ownerId == request.auth.uid;
    }
  }
}
